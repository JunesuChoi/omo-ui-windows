{
  "name": "omo-ui-macosapp",
  "productName": "OmO UI",
  "version": "0.1.0",
  "private": true,
  "description": "macOS desktop app for omo built from the DeepSeek Harness GUI",
  "license": "MIT",
  "author": "sigridjineth",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build:renderer && npm run build:electron",
    "build:renderer": "vite build",
    "build:electron": "node scripts/build-electron.mjs",
    "start": "electron .",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "test": "vitest run",
    "smoke:bridge": "node scripts/build-electron.mjs && node dist-electron/smoke-bridge.cjs"
  },
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "vite": "^6.4.3",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.4",
    "@types/react": "~18.3.31",
    "@types/react-dom": "~18.3.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
